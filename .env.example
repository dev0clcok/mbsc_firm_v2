APP_NAME="MBSC Firm"
APP_ENV=local
APP_KEY=base64:HnDrPALgLx+1Fi/mCzs9ovPPgL/XLmjACZeS2fy5MVk=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

APP_SUPER_ADMIN_EMAIL="admin@admin.com"
APP_DEFAULT_USER_PASSWORD="password"
APP_DATE_FORMAT="Y-m-d"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dev_mbsc
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Enquiry notifications. "log" writes the email to storage/logs and sends
# nothing; for real delivery set MAIL_MAILER=smtp and fill in the host,
# port, username and password from the mail provider. MAIL_FROM_ADDRESS
# must be an address that provider may send from. The emails are queued,
# so a queue worker (php artisan queue:work) has to be running. The
# address that receives them is set in Admin > Site Settings.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Server-side rendering for the public pages. Needs the SSR process running
# (php artisan inertia:start-ssr); pages fall back to client rendering if it is down.
INERTIA_SSR_ENABLED=true
